DATABASE_URL="postgresql://postgres:postgres@localhost:5434/fhir_integration"
PORT=5051

# Absolute base URL this service is reachable at. Used in Bundle.fullUrl, Patient.link and meta.source.
PUBLIC_BASE_URL="http://localhost:5051"

# Optional. When set, every request must send "Authorization: Bearer <API_KEY>".
API_KEY=""

# Pull sources (open sandboxes, no auth required).
SMART_BASE_URL="https://r4.smarthealthit.org"
HAPI_BASE_URL="https://hapi.fhir.org/baseR4"
FHIR_REQUEST_TIMEOUT_MS=30000
